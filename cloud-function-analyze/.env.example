# Gemini API 키 — Secret Manager에서 주입
# 로컬: cp .env.example .env 후 실키 입력
# 배포: gcloud functions deploy ... --set-secrets GEMINI_API_KEY=gemini-api-key:latest
GEMINI_API_KEY=

# Firestore 프로젝트 ID (Cloud Function 런타임에서는 자동 추론, 로컬 테스트용)
GOOGLE_CLOUD_PROJECT=

# 룰북 버전 (시스템 프롬프트와 함께 변경. 캐시 키에 포함)
RULEBOOK_VERSION=2026-05

# 모델 (기본: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS 허용 도메인 (콤마 구분)
ALLOWED_ORIGINS=https://hwjung-bit.github.io,http://localhost:5173,http://localhost:4173
